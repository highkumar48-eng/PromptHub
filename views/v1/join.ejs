<%- include('header') %><section class="narrow"><p class="eyebrow">CREATOR SETUP</p><h1>Your page starts here.</h1><p class="muted">Choose the name and link your audience will see.</p><% if(error) { %><p class="alert" role="alert"><%= error %></p><% } %><form class="card stack" action="/dashboard/profile" method="post"><label>Display name<input name="name" value="<%= form.name || '' %>" placeholder="e.g. Samir Creates" maxlength="60" required></label><label>Your handle<input name="handle" value="<%= form.handle || '' %>" placeholder="samircreates" pattern="[a-z][a-z0-9_]{2,29}" minlength="3" maxlength="30" required autocapitalize="off" autocomplete="off"><small>Your personal link: /c/yourhandle. Choose carefully; handles stay fixed in this version.</small></label><button class="button" type="submit">Create my page →</button></form></section><%- include('footer') %>
