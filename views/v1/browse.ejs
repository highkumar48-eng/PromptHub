<%- include('header') %><section class="narrow"><a class="back" href="/c/<%= owner.handle %>">← Keyword search</a><p class="eyebrow">@<%= owner.handle %><%= isDemo ? ' · DEMO' : '' %></p><h1><%= owner.name %>’s prompts</h1><% if(!items.length) { %><div class="card empty"><h2>New prompts are on their way.</h2><p>This creator has not published a prompt yet.</p></div><% } else { %><div class="prompt-list"><% items.forEach(item=> { %><a class="card prompt-list-item" href="/c/<%= owner.handle %>/prompt/<%= encodeURIComponent(item.keyword) %>"><div><code><%= item.keyword %></code><h2><%= item.title %></h2></div><span aria-hidden="true">↗</span></a><% }) %></div><% } %></section><%- include('footer') %>
