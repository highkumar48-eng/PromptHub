<%- include('header') %><section class="viewer-layout"><aside class="ad-space"><span>ADVERTISEMENT SPACE</span><small>Ads not enabled</small></aside><div class="viewer-main"><div class="creator-line"><span class="avatar"><%= owner.name.slice(0,1).toUpperCase() %></span><div><strong><%= owner.name %></strong><span>@<%= owner.handle %></span></div><% if(isDemo) { %><span class="pill">DEMO</span><% } %></div><section class="search-panel"><p class="eyebrow">FROM THE REEL TO YOU</p><h1>Enter the keyword.</h1><p class="muted">Get the exact prompt from <%= owner.name %>.</p><form class="search" action="/c/<%= owner.handle %>" method="get"><label class="sr-only" for="keyword">Reel keyword</label><input id="keyword" name="q" value="<%= q %>" placeholder="e.g. saree" maxlength="50" required autocomplete="off"><button class="button">Get prompt →</button></form><a class="browse-link" href="/c/<%= owner.handle %>/browse">Browse all prompts</a></section>
<% if(item) { %><article class="card result"><div class="heading-row"><span class="pill published">AI IMAGE PROMPT</span><code><%= item.keyword %></code></div><h2><%= item.title %></h2><label class="sr-only" for="prompt-text">Full prompt</label><textarea id="prompt-text" class="prompt-text" readonly rows="8"><%= item.body %></textarea><div class="actions"><button class="button" id="copy-prompt">Copy prompt <span aria-hidden="true">⧉</span></button><button class="button secondary" id="copy-page">Copy link</button></div><% if(isDemo) { %><p class="muted">Sample prompt for trying the flow. It is not imported from your Sheet.</p><% } %></article><% } else if(searched) { %><div class="card empty" role="status"><h2>No prompt for “<%= q %>” yet.</h2><p>Check the spelling from the reel and make sure you opened the correct creator’s link.</p></div><% } %></div><aside class="ad-space"><span>ADVERTISEMENT SPACE</span><small>Ads not enabled</small></aside></section><%- include('footer') %>
