<%- include('header') %><section class="workspace"><div class="heading-row"><div><p class="eyebrow">CREATOR STUDIO · @<%= creator.handle %></p><h1>My prompts<span class="count"><%= items.length %></span></h1><p class="muted">One keyword for every creation you share.</p></div><a class="button" href="/dashboard/new">+ Add prompt</a></div>
<% if(notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
<div class="link-card"><div><p class="eyebrow">YOUR BIO LINK</p><a href="/c/<%= creator.handle %>"><%= personalLink %></a></div><button class="button secondary small" data-copy="<%= personalLink %>">Copy link</button><a class="text-link" href="/c/<%= creator.handle %>">Open page ↗</a></div>
<div class="stats"><div><span>Total prompts</span><strong><%= items.length %></strong></div><div><span>This month’s visitors</span><strong><%= monetization.currentMonthVisitors.toLocaleString() %></strong></div><div><span>Last month’s visitors</span><strong><%= monetization.previousMonthVisitors.toLocaleString() %></strong></div><div><span>Monetization</span><strong class="status-word"><%= monetization.status === 'scheduled' ? 'Starts next month' : monetization.status === 'monetized' ? 'Enabled' : monetization.status === 'paused' ? 'Paused' : 'Building' %></strong></div></div>
<section class="monetization-card card"><div><p class="eyebrow">MONETIZATION PROGRESS</p><h2><%= monetization.status === 'scheduled' ? 'Monetization starts next month.' : monetization.status === 'monetized' ? 'Monetization is enabled.' : monetization.status === 'paused' ? 'Monetization is paused.' : 'Reach 50,000 visitors this month.' %></h2><p class="muted"><% if(monetization.status === 'scheduled') { %>You reached the threshold this calendar month. Your creator monetization begins on the first day of next month.<% } else if(monetization.status === 'monetized') { %>Your share is 50% of finalized net distributable revenue. Payout still requires admin approval.<% } else if(monetization.status === 'paused') { %>Ad serving and new revenue allocation are paused while the account is reviewed.<% } else { %>Bring 50,000 measured public visitors in one calendar month. This starts monetization from the following month; ads remain off until the platform is connected to an ad network.<% } %></p></div><div class="progress-grid"><div><span>This calendar month</span><strong><%= monetization.currentMonthVisitors.toLocaleString() %> / <%= monetization.requirements.visitors.toLocaleString() %></strong></div><div><span>Last completed month</span><strong><%= monetization.previousMonthVisitors.toLocaleString() %> / <%= monetization.requirements.visitors.toLocaleString() %></strong></div></div><a class="text-link" href="/dashboard/earnings">View monetization details →</a></section>
<div class="toolbar"><h2>Your library</h2><div><a href="/dashboard/import">Import CSV</a><a href="/dashboard/export" download>Export backup</a></div></div>
<% if(!items.length) { %><div class="card empty"><span class="empty-icon">+</span><h2>Your first prompt is the start.</h2><p>Add a keyword, title and prompt. Publish when it is ready for your audience.</p><a class="button" href="/dashboard/new">Add your first prompt</a></div><% } else { %><div class="table-wrap"><table><thead><tr><th>Prompt</th><th>Keyword</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody><% items.forEach(item=> { %><tr><td><a class="prompt-title" href="/dashboard/edit/<%= item.id %>"><%= item.title %></a></td><td><code><%= item.keyword %></code></td><td><span class="pill <%= item.status %>"><%= item.status %></span></td><td class="row-actions"><a href="/dashboard/edit/<%= item.id %>">Edit</a><% if(item.status==='published') { %><a href="/c/<%= creator.handle %>/prompt/<%= encodeURIComponent(item.keyword) %>">View ↗</a><form action="/dashboard/unpublish" method="post"><input type="hidden" name="id" value="<%= item.id %>"><button class="link-button">Unpublish</button></form><% } %></td></tr><% }) %></tbody></table></div><% } %></section><%- include('footer') %>
