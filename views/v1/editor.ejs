<%- include('header') %><section class="narrow editor"><a class="back" href="/dashboard">← My prompts</a><p class="eyebrow">CREATOR STUDIO</p><h1><%= item.id ? 'Edit prompt' : 'Add a prompt' %></h1><p class="muted">Use the same keyword in your reel and here.</p><% if(error) { %><p class="alert" role="alert"><%= error %></p><% } %><form class="card stack" action="/dashboard/prompts" method="post"><% if(item.id) { %><input type="hidden" name="id" value="<%= item.id %>"><% } %><div class="form-grid"><label>Keyword<input name="keyword" value="<%= item.keyword || '' %>" placeholder="e.g. saree" maxlength="50" required autocapitalize="off"><small>Letters, numbers, hyphens or underscores. Hindi keywords work too.</small></label><label>Visibility<select name="status"><option value="draft" <%= item.status==='draft' ? 'selected' : '' %>>Draft · only you</option><option value="published" <%= item.status==='published' ? 'selected' : '' %>>Published · viewers can find it</option></select></label></div><label>Title<input name="title" value="<%= item.title || '' %>" placeholder="Shadowed Saree Elegance" maxlength="140" required></label><label>Prompt<textarea name="body" rows="12" placeholder="Paste the complete AI image prompt here…" maxlength="20000" required><%= item.body || '' %></textarea><small>Up to 20,000 characters. Your exact text is what viewers copy.</small></label><div class="actions"><button class="button" type="submit">Save prompt</button><a href="/dashboard">Cancel</a></div></form></section><%- include('footer') %>
