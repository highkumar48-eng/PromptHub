<%- include('header') %><section class="workspace"><div class="heading-row"><div><p class="eyebrow">PLATFORM ADMIN</p><h1>Creator revenue</h1><p class="muted">Manual UPI phase. This dashboard records calculations and approvals; it never sends money itself.</p></div><span class="pill">ADMIN ONLY</span></div><% if(notice) { %><p class="notice" role="status"><%= notice %></p><% } %><section class="card admin-policy"><h2>Revenue rule</h2><p>Creator gets 50% of <strong>net distributable revenue</strong>: finalized gross revenue minus invalid-traffic reversals, revenue-specific taxes, and direct payout costs. Do not use this form for general operating costs.</p></section><div class="admin-layout"><section class="card stack"><h2>Create monthly ledger</h2><form class="stack compact-stack" action="/admin/ledger" method="post"><label>Accounting month<input type="month" name="month" value="<%= month %>" required></label><label>Creator<select name="creatorId" required><option value="">Choose creator</option><% creators.forEach(c=> { %><option value="<%= c.id %>">@<%= c.handle %> · <%= c.name %> · last month: <%= Number(c.previous_month_visitors).toLocaleString() %> visitors</option><% }) %></select></label><label>Finalized gross ad revenue (INR)<input name="grossRevenue" inputmode="decimal" placeholder="0.00" required></label><div class="form-grid"><label>Invalid-traffic reversal (INR)<input name="invalidTraffic" inputmode="decimal" value="0"></label><label>Revenue-specific tax (INR)<input name="taxDeductions" inputmode="decimal" value="0"></label></div><label>Direct payout cost (INR)<input name="directCosts" inputmode="decimal" value="0"><small>For manual UPI this is usually zero. Do not deduct hosting or general company costs.</small></label><label>Admin note<textarea name="note" rows="3" maxlength="500" placeholder="Ad-network settlement reference or adjustment reason"></textarea></label><button class="button" type="submit">Calculate ledger</button></form></section><section class="card admin-help"><h2>Monthly payout flow</h2><ol><li>Enter only settled ad-network revenue.</li><li>Review deductions with evidence.</li><li>Approve the creator share.</li><li>Send UPI manually outside PromptHub.</li><li>Record the payment reference and mark paid.</li></ol><p class="muted">A payment gateway is intentionally not connected during the validation phase.</p></section></div><div class="toolbar"><h2><%= month %> ledger</h2></div><% if(!ledgers.length) { %><div class="card empty"><h2>No ledger entries yet.</h2><p>After ad revenue settles, add a creator’s monthly calculation here.</p></div><% } else { %><div class="table-wrap"><table class="ledger-table"><thead><tr><th>Creator</th><th>Gross</th><th>Net distributable</th><th>Creator share</th><th>Status</th><th>Action</th></tr></thead><tbody><% ledgers.forEach(l=> { %><tr><td><strong>@<%= l.handle %></strong><small><%= l.name %></small></td><td>₹<%= (Number(l.gross_revenue_paise)/100).toFixed(2) %></td><td>₹<%= (Number(l.net_distributable_paise)/100).toFixed(2) %></td><td><strong>₹<%= (Number(l.creator_share_paise)/100).toFixed(2) %></strong></td><td><span class="pill <%= l.status === 'paid' ? 'published' : '' %>"><%= l.status %></span></td><td><% if(l.status === 'calculated') { %><form action="/admin/approve" method="post"><input type="hidden" name="id" value="<%= l.id %>"><button class="link-button">Approve</button></form><% } else if(l.status === 'approved') { %><form action="/admin/mark-paid" method="post" class="payment-form"><input type="hidden" name="id" value="<%= l.id %>"><input name="paymentReference" placeholder="UPI reference" maxlength="100" required><button class="link-button">Mark paid</button></form><% } else { %><small>UPI ref: <%= l.payment_reference %></small><% } %></td></tr><% }) %></tbody></table></div><% } %></section><%- include('footer') %>
